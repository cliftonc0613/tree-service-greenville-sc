---
import { business, nav } from '@/data/site';
import Icon from '@/components/Icon.astro';
---

<div class="utility-bar">
  <div class="container">
    <a href={nav.emergency.href}>Storm damage? Tree down or leaning? Call {business.phoneDisplay}</a>
    <span>Free estimates, no pressure</span>
  </div>
</div>

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="Greenville Tree and Stump, home">
      <img src="/images/logo.png" alt="" width="150" height="48" />
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <details>
        <summary aria-haspopup="true">
          Services
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <div class="dropdown">
          {nav.services.map((s) => <a href={s.href}>{s.label}</a>)}
          <hr />
          <a href={nav.servicesAll.href}>{nav.servicesAll.label}</a>
        </div>
      </details>
      <details>
        <summary aria-haspopup="true">
          Service Areas
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <div class="dropdown">
          {nav.areas.map((a) => <a href={a.href}>{a.label}</a>)}
          <hr />
          <a href={nav.areasAll.href}>{nav.areasAll.label}</a>
        </div>
      </details>
      <a href={nav.about.href}>{nav.about.label}</a>
      <a href={nav.contact.href}>{nav.contact.label}</a>
    </nav>

    <div class="header-ctas">
      <a class="btn btn--cta" href={business.phoneHref} aria-label={`Call now at ${business.phoneDisplay}`}>
        <Icon name="phone" />
        Call Now
      </a>
      <a class="btn btn--cta" href={nav.estimate.href}>Get a Free Estimate</a>
    </div>

    <div class="header-actions">
      <a class="btn btn--cta header-call" href={business.phoneHref} aria-label={`Call now at ${business.phoneDisplay}`}>
        <Icon name="phone" />
      </a>
    <details class="mobile-menu">
      <summary class="menu-toggle" aria-label="Open menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </summary>
      <div class="mobile-panel">
        <div class="container">
          <details class="mobile-group">
            <summary>Services</summary>
            {nav.services.map((s) => <a class="mobile-sub" href={s.href}>{s.label}</a>)}
            <a class="mobile-sub mobile-sub--all" href={nav.servicesAll.href}>{nav.servicesAll.label}</a>
          </details>
          <details class="mobile-group">
            <summary>Service Areas</summary>
            {nav.areas.map((a) => <a class="mobile-sub" href={a.href}>{a.label}</a>)}
            <a class="mobile-sub mobile-sub--all" href={nav.areasAll.href}>{nav.areasAll.label}</a>
          </details>
          <a href={nav.about.href}>{nav.about.label}</a>
          <a href={nav.contact.href}>{nav.contact.label}</a>
          <a href={nav.estimate.href}>{nav.estimate.label}</a>
        </div>
      </div>
    </details>
    </div>
  </div>
</header>

<script>
  // Close open nav dropdowns on Escape or when clicking elsewhere.
  const menus = document.querySelectorAll<HTMLDetailsElement>('.nav-desktop details, .mobile-menu');
  document.addEventListener('click', (e) => {
    menus.forEach((d) => { if (d.open && !d.contains(e.target as Node)) d.open = false; });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    menus.forEach((d) => {
      if (d.open) { d.open = false; d.querySelector('summary')?.focus(); }
    });
  });
  // Opening one desktop dropdown closes the other.
  menus.forEach((d) => d.addEventListener('toggle', () => {
    if (!d.open) return;
    menus.forEach((o) => { if (o !== d && o.open) o.open = false; });
  }));
</script>

<div class="mobile-callbar" role="region" aria-label="Quick contact">
  <a href={business.phoneHref}>
    <Icon name="phone" />
    Call Now
  </a>
  <a href={nav.estimate.href}>Free Estimate</a>
</div>
