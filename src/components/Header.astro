---
import { business, nav } from '@/data/site';
import Icon from '@/components/Icon.astro';
---

<div class="utility-bar">
  <div class="container">
    <a href={nav.emergency.href}>Storm damage? Tree down or leaning? Call {business.phoneDisplay}</a>
    <span>Free estimates, no pressure</span>
  </div>
</div>

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="Greenville Tree and Stump, home">
      <img src="/images/logo.png" alt="" width="150" height="48" />
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <details>
        <summary aria-haspopup="true">
          Services
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <div class="dropdown">
          {nav.services.map((s) => <a href={s.href}>{s.label}</a>)}
          <hr />
          <a href={nav.servicesAll.href}>{nav.servicesAll.label}</a>
        </div>
      </details>
      <a href="/service-areas">Service Areas</a>
      <details>
        <summary aria-haspopup="true">
          {nav.about.label}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <div class="dropdown dropdown--narrow">
          <a href={nav.about.href}>About us</a>
          <a href="/blog">Blog</a>
        </div>
      </details>
      <a href={nav.contact.href}>{nav.contact.label}</a>
    </nav>

    <div class="header-ctas">
      <a class="btn btn--cta" href={business.phoneHref} aria-label={`Call now at ${business.phoneDisplay}`}>
        <Icon name="phone" />
        Call Now
      </a>
      <a class="btn btn--cta" href={nav.estimate.href}>Get a Free Estimate</a>
    </div>

    <div class="header-actions">
      <a class="btn btn--cta header-call" href={business.phoneHref} aria-label={`Call now at ${business.phoneDisplay}`}>
        <Icon name="phone" />
      </a>
    <details class="mobile-menu">
      <summary class="menu-toggle" aria-label="Open menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </summary>
      <div class="mobile-panel">
        <div class="container">
          <details class="mobile-group">
            <summary>Services</summary>
            <div class="mobile-group__body">
              {nav.services.map((s) => <a class="mobile-sub" href={s.href}>{s.label}</a>)}
              <a class="mobile-sub mobile-sub--all" href={nav.servicesAll.href}>{nav.servicesAll.label}</a>
            </div>
          </details>
          <a href="/service-areas">Service Areas</a>
          <details class="mobile-group">
            <summary>{nav.about.label}</summary>
            <div class="mobile-group__body">
              <a class="mobile-sub" href={nav.about.href}>About us</a>
              <a class="mobile-sub" href="/blog">Blog</a>
            </div>
          </details>
          <a href={nav.contact.href}>{nav.contact.label}</a>
          <a href={nav.estimate.href}>{nav.estimate.label}</a>
        </div>
      </div>
    </details>
    </div>
  </div>
</header>

<script>
  // Shared motion settings. Reduced-motion users get instant open and close.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const EASE = 'cubic-bezier(0.2, 0.7, 0.2, 1)';
  const DUR = 240;

  // Slide a submenu body open or closed. Resolves when the animation has finished.
  const slide = (body: HTMLElement, open: boolean): Promise<void> => {
    if (reduce) return Promise.resolve();
    const h = body.scrollHeight;
    const frames: Keyframe[] = open
      ? [{ height: '0px', opacity: 0 }, { height: `${h}px`, opacity: 1 }]
      : [{ height: `${h}px`, opacity: 1 }, { height: '0px', opacity: 0 }];
    body.style.overflow = 'hidden';
    const anim = body.animate(frames, { duration: DUR, easing: EASE, fill: 'forwards' });
    return anim.finished.then(() => { anim.cancel(); body.style.overflow = ''; });
  };

  // Fade and lift the whole menu panel in or out.
  const fade = (el: HTMLElement, open: boolean): Promise<void> => {
    if (reduce) return Promise.resolve();
    const frames: Keyframe[] = open
      ? [{ opacity: 0, transform: 'translateY(-8px)' }, { opacity: 1, transform: 'none' }]
      : [{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'translateY(-8px)' }];
    const anim = el.animate(frames, { duration: DUR, easing: EASE, fill: 'forwards' });
    return anim.finished.then(() => anim.cancel());
  };

  // Mobile menu: groups are accordion-style, open and close with motion, and close on page scroll.
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  const panel = menu?.querySelector<HTMLElement>('.mobile-panel') ?? null;
  const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>('.mobile-group'));
  const bodyOf = (g: HTMLDetailsElement) => g.querySelector<HTMLElement>('.mobile-group__body');

  const closeGroup = async (g: HTMLDetailsElement) => {
    const b = bodyOf(g);
    if (!g.open || !b) return;
    await slide(b, false);
    g.open = false;
  };

  const openGroup = async (g: HTMLDetailsElement) => {
    const b = bodyOf(g);
    if (!b) return;
    g.open = true;
    await slide(b, true);
  };

  let openedAt = 0;
  let menuBusy = false;

  const openMenu = async () => {
    if (!menu || !panel) return;
    menu.open = true;
    openedAt = window.scrollY;
    await fade(panel, true);
  };

  const closeMenu = async () => {
    if (!menu || !panel || !menu.open) return;
    await Promise.all(groups.filter((g) => g.open).map(closeGroup));
    await fade(panel, false);
    menu.open = false;
  };

  if (menu) {
    menu.querySelector('summary')?.addEventListener('click', async (e) => {
      e.preventDefault();
      if (menuBusy) return;
      menuBusy = true;
      try { menu.open ? await closeMenu() : await openMenu(); } finally { menuBusy = false; }
    });

    // Close when the page scrolls. Scrolling inside the panel does not count, and a nudge under 8px is ignored.
    window.addEventListener('scroll', () => {
      if (menu.open && !menuBusy && Math.abs(window.scrollY - openedAt) > 8) {
        menuBusy = true;
        closeMenu().finally(() => { menuBusy = false; });
      }
    }, { passive: true });

    // Tapping outside the menu closes it.
    document.addEventListener('click', (e) => {
      if (menu.open && !menuBusy && !menu.contains(e.target as Node)) {
        menuBusy = true;
        closeMenu().finally(() => { menuBusy = false; });
      }
    });
  }

  groups.forEach((g) => {
    g.querySelector('summary')?.addEventListener('click', async (e) => {
      e.preventDefault();
      if (g.dataset.busy) return;
      g.dataset.busy = '1';
      try {
        if (g.open) {
          await closeGroup(g);
        } else {
          // Accordion: opening this group closes any other open group.
          await Promise.all(groups.filter((o) => o !== g && o.open).map(closeGroup));
          await openGroup(g);
        }
      } finally {
        delete g.dataset.busy;
      }
    });
  });

  // Shrink the header after the page scrolls down. The gap between the two thresholds
  // (shrink past 60px, grow back under 8px) stops it flickering around a single point.
  const siteHeader = document.querySelector<HTMLElement>('.site-header');
  if (siteHeader) {
    let shrunk = false;
    const updateHeader = () => {
      const y = window.scrollY;
      if (!shrunk && y > 60) {
        shrunk = true;
        siteHeader.classList.add('is-shrunk');
      } else if (shrunk && y < 8) {
        shrunk = false;
        siteHeader.classList.remove('is-shrunk');
      }
    };
    window.addEventListener('scroll', updateHeader, { passive: true });
    updateHeader();
  }

  // Desktop dropdowns: opening one closes the other, and a click outside closes them.
  const desktopMenus = document.querySelectorAll<HTMLDetailsElement>('.nav-desktop details');
  document.addEventListener('click', (e) => {
    desktopMenus.forEach((d) => { if (d.open && !d.contains(e.target as Node)) d.open = false; });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    desktopMenus.forEach((d) => {
      if (d.open) { d.open = false; d.querySelector('summary')?.focus(); }
    });
  });
  desktopMenus.forEach((d) => d.addEventListener('toggle', () => {
    if (!d.open) return;
    desktopMenus.forEach((o) => { if (o !== d && o.open) o.open = false; });
  }));
</script>

<div class="mobile-callbar" role="region" aria-label="Quick contact">
  <a href={business.phoneHref}>
    <Icon name="phone" />
    Call Now
  </a>
  <a href={nav.estimate.href}>Free Estimate</a>
</div>
