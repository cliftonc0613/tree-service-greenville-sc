---
import { business } from '@/data/site';

interface Props {
  heading: string;
  text: string;
}

const { heading, text } = Astro.props;
---

<section class="section section--soft cta-band-section">
  <div class="cta-band">
    <div class="container cta-band__inner">
      <h2>{heading}</h2>
      <p>{text}</p>
      <div class="btn-row">
        <a class="btn btn--cta" href="/contact#estimate">Get a Free Estimate</a>
        <a class="btn btn--outline" href={business.phoneHref}>Call {business.phoneDisplay}</a>
      </div>
    </div>
  </div>
</section>
