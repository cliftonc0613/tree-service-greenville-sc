---
import { absoluteUrl } from '@/data/site';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
  /** 'hero' = light text on the dark hero. 'below' = dark text on the page background. */
  variant?: 'hero' | 'below';
}

const { items, variant = 'hero' } = Astro.props;
// Home is always the first crumb. Last item is the current page (no link).
const all: Crumb[] = [{ label: 'Home', href: '/' }, ...items];
const ld = {
  '@type': 'BreadcrumbList',
  itemListElement: all.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: absoluteUrl(c.href) } : {}),
  })),
};
---

<nav class:list={['crumbs', variant === 'below' && 'crumbs--below']} aria-label="Breadcrumb">
  <ol>
    {all.map((c, i) => (
      <li>
        {i < all.length - 1 && c.href ? (
          <a href={c.href}>{c.label}</a>
        ) : (
          <span aria-current="page">{c.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...ld })} />
