---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { business } from '@/data/site';
import type { PageImage } from '@/data/types';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  h1: string;
  lead: string;
  crumbs: Crumb[];
  eyebrow?: string;
  showCta?: boolean;
  /** Optional background image. Pages without one keep the plain forest-green band. */
  image?: PageImage;
}

const { h1, lead, crumbs, eyebrow, showCta = true, image } = Astro.props;
---

<section class:list={['page-hero', image && 'page-hero--image']}>
  {image && (
    <div class="page-hero__media">
      <img src={image.src} alt={image.alt} width="1440" height="803" decoding="async" />
    </div>
  )}
  <div class="container">
    <Breadcrumbs items={crumbs} />
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{h1}</h1>
    <p class="lead">{lead}</p>
    {showCta && (
      <div class="btn-row" style="margin-top:1.5rem">
        <a class="btn btn--cta" href="/contact#estimate">Get a Free Estimate</a>
        <a class="btn btn--outline" href={business.phoneHref}>Call {business.phoneDisplay}</a>
      </div>
    )}
  </div>
</section>

<script>
  // Same intro as the homepage hero, for pages with a background image header.
  // Reduced-motion users get no animation at all.
  import { gsap } from 'gsap';

  const hero = document.querySelector<HTMLElement>('.page-hero--image');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && !reduceMotion) {
    const intro = gsap.timeline({ defaults: { ease: 'power3.out' } });
    intro
      .from('.page-hero--image .page-hero__media img', { scale: 1.05, opacity: 0, duration: 1.6, ease: 'power2.out' }, 0)
      .from('.page-hero--image .eyebrow', { y: 12, opacity: 0, duration: 0.6 }, 0.1)
      .from('.page-hero--image h1', { y: 28, opacity: 0, duration: 0.9 }, 0.2)
      .from('.page-hero--image .lead', { y: 16, opacity: 0, duration: 0.7 }, 0.45)
      .from('.page-hero--image .btn-row .btn', { y: 12, opacity: 0, duration: 0.5, stagger: 0.08 }, 0.6);
  }
</script>
