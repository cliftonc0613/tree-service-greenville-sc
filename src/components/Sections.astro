---
import type { PageImage, Section } from '@/data/types';
import Heading from '@/components/Heading.astro';
import { areas } from '@/data/areas';

interface Props {
  sections: Section[];
  /** Start heading level for the first section. Default h2. */
  tone?: 'white' | 'soft';
  /** Optional picture. When set, the first section becomes two columns with the picture on the right. */
  firstImage?: PageImage;
  /** When true, every city name in the paragraphs links to that city's page. Used on service pages. */
  linkCities?: boolean;
}

const { sections, tone = 'white', firstImage, linkCities = false } = Astro.props;

// City names, longest first so "Fountain Inn" wins over any shorter overlap.
const cityNames = areas
  .map((a) => ({ name: a.name, href: `/service-areas/${a.slug}` }))
  .sort((a, b) => b.name.length - a.name.length);
const cityPattern = new RegExp(
  `\\b(${cityNames.map((c) => c.name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})\\b`,
  'g'
);
const escapeHtml = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const withCityLinks = (t: string) =>
  escapeHtml(t).replace(cityPattern, (m) => `<a href="${cityNames.find((c) => c.name === m)!.href}">${m}</a>`);
---

{sections.map((s, i) => {
  const media = s.image ?? (i === 0 ? firstImage : undefined);
  const withImage = Boolean(media);
  const withSidebar = Boolean(s.sidebar?.length);
  return (
  <section class:list={['section', tone === 'white' ? 'section--white' : undefined]} aria-labelledby={`sec-${i}`}>
    <div class:list={['container', withImage ? 'split section-split' : undefined, withImage && s.imageSide === 'left' ? 'split--reverse' : undefined, withSidebar ? 'container--sidebar' : undefined]}>
      <div class="prose">
        <Heading id={`sec-${i}`} text={s.heading} />
        {s.paragraphs.map((p) => (linkCities ? <p set:html={withCityLinks(p)} /> : <p>{p}</p>))}
        {s.bullets && (
          <ul class:list={['checklist', s.bulletLayout === 'cards' && 'checklist--cards']}>
            {s.bullets.map((b) => <li>{b}</li>)}
          </ul>
        )}
        {s.subsections && (
          <div class:list={[s.subsectionLayout === 'columns' && 'subsection-columns']}>
            {s.subsections.map((sub) => (
              <div>
                <h3>{sub.heading}</h3>
                {sub.paragraphs.map((p) => (linkCities ? <p set:html={withCityLinks(p)} /> : <p>{p}</p>))}
                {sub.bullets && (
                  <ul class:list={['checklist', sub.bulletLayout === 'cards' && 'checklist--cards']}>
                    {sub.bullets.map((b) => <li>{b}</li>)}
                  </ul>
                )}
              </div>
            ))}
          </div>
        )}
      </div>
      {withSidebar && (
        <aside class="facts-sidebar" aria-label="Key facts">
          {s.sidebar!.map((f) => (
            <div class="facts-box">
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </div>
          ))}
        </aside>
      )}
      {withImage && media && (
        <figure class="section-media">
          <img src={media.src} alt={media.alt} width="1440" height="803" loading="lazy" />
        </figure>
      )}
    </div>
  </section>
  );
})}
