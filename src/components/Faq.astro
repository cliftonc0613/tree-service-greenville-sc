---
import type { Faq } from '@/data/types';
import Heading from '@/components/Heading.astro';

interface Props {
  heading?: string;
  faqs: Faq[];
  id?: string;
}

// No FAQPage JSON-LD on purpose: Google restricted FAQ rich results to government and healthcare sites (Aug 2023).
// The visible accordion is kept for visitors.
const { heading = 'Common questions', faqs, id = 'faq' } = Astro.props;
---

<section class="section section--white faq-section" aria-labelledby={`${id}-heading`} id={id}>
  <div class="container">
    <span class="eyebrow">FAQ</span>
    <Heading id={`${id}-heading`} text={heading} />
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
