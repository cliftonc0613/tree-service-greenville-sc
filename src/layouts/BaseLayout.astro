---
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  schema?: object[];
  noindex?: boolean;
  /** Set false on pages where the sticky call bar would cover a form. */
  callbar?: boolean;
}

const { title, description, path, schema = [], noindex = false, callbar = true } = Astro.props;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#164a34" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Font pair: Oswald (display) + Source Sans 3 (body), from astro-business-builder font-pairs.md pair 1. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Source+Sans+3:wght@400;600;700&display=swap"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <SEO title={title} description={description} path={path} schema={schema} noindex={noindex} />
  </head>
  <body class:list={[callbar && 'has-callbar']}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
