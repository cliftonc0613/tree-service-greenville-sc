---
import { business } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Heading from '@/components/Heading.astro';
import CtaBand from '@/components/CtaBand.astro';
import { areas } from '@/data/areas';

const title = `About Our Tree Service | ${business.name}`;
const description =
  `${business.name} does tree removal, trimming, and stump grinding for Greenville, SC homes. Safety first, a clean yard before we leave.`;
---

<BaseLayout title={title} description={description} path="/about">
  <PageHero
    h1={`About ${business.name}`}
    lead="Our job is to make Greenville homeowners' trees safe and their yards usable again, so they never have to gamble on a dangerous tree."
    crumbs={[{ label: 'About' }]}
    eyebrow="Who we are"
    image={{ src: '/images/pages/about-truck.jpg', alt: `AI-generated illustration of a white ${business.name} pickup with a ladder rack, parked next to a yellow backhoe loader on a cleared lot in front of woods` }}
  />

  <!-- Intro: text on the left, framed picture on the right. -->
  <section class="section section--white" aria-labelledby="about-work-heading">
    <div class="container about-split">
      <div class="about-split__text">
        <Heading id="about-work-heading" text="How we *work*" />
        <p>Every job starts the same way. We come out for a free site visit, look at the tree and the space around it, and explain what it needs. Then we give you a written quote with the scope, the method, and the cleanup spelled out.</p>
        <p>We put safety before speed or price. A tree is never worth the risk of a fall, so when a tree is a hazard, we say so plainly. When a tree can be saved, we say that too.</p>
        <p>We do not call a job finished until the yard is clean.</p>
      </div>
      <figure class="about-split__media">
        <img
          src="/images/pages/about-crew.jpg"
          width="1440"
          height="804"
          loading="lazy"
          alt="AI-generated illustration of three tree care workers in safety vests standing by a green pickup with a ladder rack and chainsaws"
        />
      </figure>
    </div>
  </section>

  <!-- Coverage: centered intro and a row of town tiles. -->
  <section class="section section--soft about-towns" aria-labelledby="about-towns-heading">
    <div class="container">
      <div class="about-towns__intro">
        <Heading id="about-towns-heading" text="Greenville and the *Upstate towns* we serve" />
        <p>Homeowners in Greenville, SC and nearby Upstate towns, including people with a leaning oak over the house, a stump in the yard, or a tree down after a storm. We also quote commercial and HOA tree work, one property at a time.</p>
        <p>Pick your town for local details, or call us with your address. We will tell you honestly whether we can get a crew there and the earliest visit we can offer.</p>
      </div>
      <ul class="town-tiles town-tiles--center">
        {areas.map((a) => (
          <li><a href={`/service-areas/${a.slug}`}>{a.name}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- What to expect: three short cards, then the credentials placeholder. -->
  <section class="section section--white" aria-labelledby="about-expect-heading">
    <div class="container">
      <Heading id="about-expect-heading" text="What you can *expect* from us" class="heading--center" />
      <div class="grid grid--3">
        <div class="card">
          <h3>No-pressure estimates</h3>
          <p>Free estimates, with no pressure to decide on the spot.</p>
        </div>
        <div class="card">
          <h3>Honest, written pricing</h3>
          <p>Honesty about price and scope, in writing. Plain language, not tree-trade jargon.</p>
        </div>
        <div class="card">
          <h3>A clean yard</h3>
          <p>Respect for your property, including cleanup before we leave. And a call back when we say we will call back.</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand heading="Start with a free estimate" text="Tell us about your tree. We will call you back to set up a free site visit." />
</BaseLayout>
