---
import { business } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import { areas } from '@/data/areas';

const title = `Service Areas Around Greenville | ${business.name}`;
const description =
  `Tree removal, trimming, and stump grinding across Greenville and nearby Upstate towns. Free written estimates from ${business.name}.`;
---

<BaseLayout title={title} description={description} path="/service-areas">
  <PageHero
    h1="Areas We Serve Around Greenville"
    lead="We work in Greenville and the towns around it. Pick your town for local details, or call us to confirm coverage for your address."
    crumbs={[{ label: 'Service Areas' }]}
    eyebrow="Coverage"
    image={{ src: '/images/pages/service-areas-hub.jpg', alt: 'Illustration of a quiet residential street lined with mature trees in autumn' }}
  />

  <section class="section section--white">
    <div class="container">
      <div class="prose" style="max-width:48rem;margin-bottom:2.5rem">
        <h2>Choose your town</h2>
        <p>Each town below has its own page with local details on trimming, removal, and stump grinding there. Pick your town to see what we do in that area and how to set up a free site visit.</p>
      </div>
      <div class="grid grid--2">
        {areas.map((a) => (
          <a class="card card--area" href={`/service-areas/${a.slug}`}>
            {a.image && (
              <span class="card__reveal" aria-hidden="true">
                <img data-src={a.image.src} alt="" width="1440" height="803" decoding="async" />
              </span>
            )}
            <span class="eyebrow" style="margin-bottom:0.3rem">{a.county}</span>
            <h2 style="font-size:1.5rem;text-transform:none;letter-spacing:0.02em">{a.name}, SC</h2>
            <p>{a.summary}</p>
            <span class="card__more">View {a.name} page</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container prose" style="max-width:48rem">
      <h2>Not sure if we cover your town?</h2>
      <p>Call us with your address. We will tell you honestly whether we can get a crew there and the earliest visit we can offer.</p>
    </div>
  </section>

  <CtaBand heading="Check your address" text="Call or send a request. We will confirm coverage and set up a free site visit." />
</BaseLayout>

<script>
  // Each town photo loads the first time its card is hovered or focused, so the page does not fetch all of them up front.
  document.querySelectorAll<HTMLElement>('.card--area').forEach((card) => {
    const img = card.querySelector<HTMLImageElement>('.card__reveal img');
    if (!img) return;
    const load = () => {
      if (!img.getAttribute('src') && img.dataset.src) img.src = img.dataset.src;
    };
    card.addEventListener('pointerenter', load, { once: true });
    card.addEventListener('focus', load, { once: true });
  });
</script>
