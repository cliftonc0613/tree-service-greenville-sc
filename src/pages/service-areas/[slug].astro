---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Sections from '@/components/Sections.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import { areas } from '@/data/areas';
import { areaImages } from '@/data/areaImages';
import { services } from '@/data/services';
import { absoluteUrl } from '@/data/site';
import type { Area } from '@/data/types';

export function getStaticPaths() {
  return areas.map((a) => ({ params: { slug: a.slug }, props: { area: a } }));
}

interface Props {
  area: Area;
}

const { area } = Astro.props;
const path = `/service-areas/${area.slug}`;

// Every service gets a card, so each city page links to all seven of its combo pages.
const coreServices = services;

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${absoluteUrl(path)}#webpage`,
    url: absoluteUrl(path),
    name: area.h1,
    about: { '@type': 'City', name: area.name },
  },
];
---

<BaseLayout title={area.title} description={area.metaDescription} path={path} schema={schema}>
  <PageHero
    h1={area.h1}
    lead={area.lead}
    crumbs={[{ label: 'Service Areas', href: '/service-areas' }, { label: area.name }]}
    eyebrow={area.county}
    image={area.image}
  />

  <Sections sections={area.sections} firstImage={areaImages[area.slug]} />

  <section class="section section--soft">
    <div class="container">
      <h2>Services in {area.name}</h2>
      <div class="grid grid--3">
        {coreServices.map((s) => (
          <a class="card" href={`/services/${area.slug}/${s.slug}`}>
            <h3>{s.name}</h3>
            <p>{s.summary}</p>
            <span class="card__more">Learn more</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="about-area-heading">
    <div class="container container--wide area-about">
      <div class="area-about__main">
        <div class="area-about__text">
          <h2 id="about-area-heading">About the area</h2>
          <p>{area.geography}</p>
        </div>
        {area.landmarkImage && (
          <figure class="area-facts__photo">
            <img src={area.landmarkImage.src} alt={area.landmarkImage.alt} width="1440" height="620" loading="lazy" decoding="async" />
            <figcaption>{area.landmarkImage.caption}</figcaption>
          </figure>
        )}
      </div>
      <div class="area-about__nearby">
        <h3>Nearby towns we serve</h3>
        <ul class="town-tiles">
          {area.nearby.map((n) => (
            <li><a href={`/service-areas/${n.slug}`}>{n.name}</a></li>
          ))}
        </ul>
        <a class="area-about__all" href="/service-areas">See all service areas</a>
      </div>
    </div>
  </section>

  {((area.landmarks?.length ?? 0) > 0 || (area.mainRoads?.length ?? 0) > 0 || Boolean(area.responseArea)) && (
    <section class="section section--white" aria-labelledby="area-facts-heading">
      <div class="container container--wide">
        <div class="area-facts">
          {(area.landmarks?.length ?? 0) > 0 && (
            <div class="area-facts__card">
              <h2 id="area-facts-heading">{area.name} landmarks we know</h2>
              <ul class="area-facts__list">
                {area.landmarks!.map((l) => <li>{l}</li>)}
              </ul>
            </div>
          )}
          {(area.mainRoads?.length ?? 0) > 0 && (
            <div class="area-facts__card">
              <h2>Main roads around {area.name}</h2>
              <ul class="area-facts__roads">
                {area.mainRoads!.map((r) => <li>{r}</li>)}
              </ul>
            </div>
          )}
        </div>
        {area.responseArea && (
          <p class="area-facts__response"><strong>Response area:</strong> {area.responseArea}</p>
        )}
      </div>
    </section>
  )}

  <Faq heading={`${area.name} tree service: common questions`} faqs={area.faqs} id="faq" />

  <CtaBand heading={`Tree work in ${area.name}?`} text="Tell us about the tree or the yard. We will call you back to set up a free visit and a written quote." />
</BaseLayout>
